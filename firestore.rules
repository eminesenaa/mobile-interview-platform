rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Login olmadan okunabilir (username → email sorgusu için)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Login olmadan okunabilir (username → email sorgusu için)
    match /hr_users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Geri kalan her şey: login olmuş herkes okuyup yazabilir
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}